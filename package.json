{
  "name": "vordik",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "node tools/build-cloudflare-assets.mjs",
    "predev": "npm run build:assets",
    "dev": "wrangler dev",
    "predeploy": "npm run build:assets",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply vordik-ratings --local",
    "db:migrate:remote": "wrangler d1 migrations apply vordik-ratings --remote",
    "test": "node --test server.test.mjs cloudflare/worker.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}
